---
import { categories, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-footer" href="/">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span class="brand-text">{site.name}</span>
      </a>
      <p>Biến vấn đề ở đại học thành bước làm cụ thể.</p>
    </div>
    <div>
      <h2>10 chủ đề</h2>
      <ul class="footer-category-list">
        {categories.map((category) => <li><a href={`/chu-de/${category.id}/`}>{category.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Thông tin</h2>
      <ul>
        <li><a href="/gioi-thieu/">Về chúng tôi</a></li>
        <li><a href="/lien-he/">Liên hệ</a></li>
        <li><a href="/lo-trinh/">Lộ trình phát triển</a></li>
        <li><a href="/sinh-vien-it/">Cẩm nang Sinh viên IT</a></li>
        <li><a href="/cong-cu/">Công cụ miễn phí</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>Không quảng cáo trá hình. Không thu thập dữ liệu từ các công cụ.</span>
  </div>
</footer>
