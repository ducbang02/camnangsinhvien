---
import { categories, primaryNav, site } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} — Trang chủ`}>
      <span class="brand-mark" aria-hidden="true">C</span>
      <span class="brand-text">Cẩm nang <strong>sinh viên</strong></span>
    </a>

    <nav class="desktop-nav" aria-label="Điều hướng chính">
      <div class="mega-nav">
        <a class="mega-trigger" href="/#chu-de">Cẩm nang <span aria-hidden="true">⌄</span></a>
        <div class="mega-panel">
          <div class="mega-heading">
            <div><span>10 chủ đề</span><strong>Chọn đúng việc bạn đang cần giải quyết</strong></div>
            <a href="/cam-nang/">Xem tất cả bài viết →</a>
          </div>
          <div class="mega-grid">
            {categories.map((category) => (
              <a class="mega-item" href={`/chu-de/${category.id}/`}>
                <span class={`mega-number accent-${category.accent}`}>{category.number}</span>
                <span><strong>{category.name}</strong><small>{category.menuDescription}</small></span>
              </a>
            ))}
          </div>
        </div>
      </div>
      {primaryNav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary><span>Menu</span><span class="menu-lines" aria-hidden="true"></span></summary>
      <nav aria-label="Điều hướng trên điện thoại">
        <a class="mobile-overview" href="/cam-nang/">Tất cả bài viết</a>
        <p>10 chủ đề</p>
        <div class="mobile-categories">
          {categories.map((category) => (
            <a href={`/chu-de/${category.id}/`}><span>{category.number}</span>{category.shortName}</a>
          ))}
        </div>
        {primaryNav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  let headerController: AbortController | undefined;

  function setupHeader() {
    headerController?.abort();
    headerController = new AbortController();
    const { signal } = headerController;
    const navigationDetails = [...document.querySelectorAll<HTMLDetailsElement>('.site-header details')];
    const megaNav = document.querySelector<HTMLElement>('.mega-nav');
    const megaTrigger = megaNav?.querySelector<HTMLAnchorElement>('.mega-trigger');

    megaTrigger?.addEventListener('click', () => {
      megaNav?.setAttribute('data-menu-suppressed', '');
    }, { signal });

    megaNav?.addEventListener('pointerleave', () => {
      megaNav.removeAttribute('data-menu-suppressed');
    }, { signal });

    megaNav?.addEventListener('focusin', () => {
      megaNav.removeAttribute('data-menu-suppressed');
    }, { signal });

    document.addEventListener('click', (event) => {
      for (const details of navigationDetails) {
        if (details.open && !details.contains(event.target as Node)) details.open = false;
      }
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      for (const details of navigationDetails) details.open = false;
    }, { signal });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>
