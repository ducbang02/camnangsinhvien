---
import Icon from './Icon.astro';

interface Props {
  tool: {
    slug: string;
    name: string;
    description: string;
    icon: string;
    href?: string;
  };
}

const { tool } = Astro.props;
const href = tool.href ?? `/cong-cu/${tool.slug}/`;
const isExternal = href.startsWith('http');
---

<a class="tool-card" href={href}>
  <span class="tool-icon"><Icon name={tool.icon} size={25} /></span>
  <span class="tool-copy">
    <strong>{tool.name}</strong>
    <span>{tool.description}</span>
  </span>
  <span class="tool-arrow"><Icon name={isExternal ? 'external' : 'arrow'} size={20} /></span>
</a>
