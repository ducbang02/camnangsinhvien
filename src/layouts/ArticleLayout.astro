---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { articleSlug, formatDate, getCategory } from '../data/site';

interface Props {
  article: CollectionEntry<'articles'>;
  headings: { depth: number; slug: string; text: string }[];
  related: CollectionEntry<'articles'>[];
}

const { article, headings, related } = Astro.props;
const { data } = article;
const category = getCategory(data.category);
const heroImage = data.thumbnail || category?.heroImage;
const url = new URL(`/cam-nang/${articleSlug(article.id)}/`, Astro.site ?? Astro.url.origin);
const metaTitle = data.seoTitle || data.title;
const metaDescription = data.seoDescription || data.description;
const showAdPreview = import.meta.env.DEV;
const toolIsExternal = data.tool?.startsWith('http') ?? false;
const modifiedDate = [data.publishedDate, data.updatedDate, data.reviewedDate]
  .filter((date): date is Date => Boolean(date))
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: metaDescription,
    datePublished: data.publishedDate.toISOString(),
    dateModified: modifiedDate.toISOString(),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@type': 'Organization', name: 'Cẩm nang sinh viên' },
    mainEntityOfPage: url.href,
    articleSection: category?.name,
    image: heroImage ? new URL(heroImage, url).href : undefined,
    keywords: data.tags.join(', '),
    inLanguage: 'vi-VN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: new URL('/', url).href },
      { '@type': 'ListItem', position: 2, name: 'Cẩm nang', item: new URL('/cam-nang/', url).href },
      { '@type': 'ListItem', position: 3, name: category?.name, item: new URL(`/chu-de/${data.category}/`, url).href },
      { '@type': 'ListItem', position: 4, name: data.title, item: url.href },
    ],
  },
];
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={url.pathname} schema={schema} ogType="article" image={heroImage}>
  <article>
    <header class="article-hero">
      {heroImage && (
        <img
          class="article-hero-image"
          src={heroImage}
          alt={data.thumbnail ? data.thumbnailAlt || '' : ''}
          width="1536"
          height="864"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
      <div class="article-hero-shade" aria-hidden="true"></div>
      <div class="article-hero-content container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a><span>/</span><a href="/cam-nang/">Cẩm nang</a><span>/</span><a href={`/chu-de/${data.category}/`}>{category?.shortName}</a><span>/</span><span aria-current="page">{data.title}</span>
        </nav>
        <a class={`topic-label accent-${category?.accent}`} href={`/chu-de/${data.category}/`}>{category?.name}</a>
        <h1>{data.title}</h1>
        <div class="byline">
          <span>{data.author}</span><span aria-hidden="true">·</span>
          <time datetime={(data.updatedDate ?? data.publishedDate).toISOString()}>Cập nhật {formatDate(data.updatedDate ?? data.publishedDate)}</time>
          <span aria-hidden="true">·</span><span>{data.readingMinutes ?? 6} phút đọc</span>
        </div>
      </div>
    </header>

    <div class="article-intro">
      <p class="article-dek narrow">{data.description}</p>
      {data.reviewer && data.reviewedDate && (
        <aside class="article-review" aria-label="Thông tin rà soát nội dung">
          <Icon name="shield" size={22} />
          <div>
            <strong>Đã được rà soát bởi {data.reviewer}</strong>
            <span>Rà soát ngày <time datetime={data.reviewedDate.toISOString()}>{formatDate(data.reviewedDate)}</time></span>
          </div>
        </aside>
      )}
    </div>

    <div class="container article-shell">
      {headings.filter((heading) => heading.depth === 2).length > 1 && (
        <aside class="toc" aria-labelledby="toc-title">
          <p id="toc-title">Trong bài này</p>
          <ol>
            {headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </aside>
      )}
      <div class="article-body prose">
        <slot />
        {data.tool && (
          <div class="article-tool-cta">
            <span class="tool-icon"><Icon name="spark" size={24} /></span>
            <div><strong>Đừng chỉ đọc — thử ngay trên công cụ</strong><p>Công cụ miễn phí, không cần tài khoản.</p></div>
            <a class="button button-primary" href={data.tool}>Mở công cụ <Icon name={toolIsExternal ? 'external' : 'arrow'} size={18} /></a>
          </div>
        )}
        {data.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-title">
            <h2 id="sources-title">Nguồn tham khảo</h2>
            <ul>
              {data.sources.map((source) => <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.label} <span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </section>
        )}
      </div>
    </div>
  </article>

  {showAdPreview && (
    <div class="container ad-slot-end-wrap">
      <aside class="ad-slot-preview ad-slot-preview-end" aria-label="Vị trí quảng cáo mẫu cuối bài viết">
        <span>Quảng cáo</span>
        <strong>Vị trí quảng cáo cuối bài</strong>
        <small>Bản mẫu chỉ hiển thị trên local</small>
      </aside>
    </div>
  )}

  {related.length > 0 && (
    <section class="section section-muted">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Bước tiếp theo</p><h2>Đọc tiếp trong cùng hành trình</h2></div></div>
        <div class="article-grid">{related.map((item) => <ArticleCard article={item} compact />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
