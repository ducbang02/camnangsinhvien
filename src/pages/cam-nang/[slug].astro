---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { articleSlug } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((article) => ({ params: { slug: articleSlug(article.id) }, props: { article, articles } }));
}

interface Props {
  article: CollectionEntry<'articles'>;
  articles: CollectionEntry<'articles'>[];
}
const { article, articles } = Astro.props;
const { Content, headings } = await render(article);
const related = articles
  .filter((item) => item.id !== article.id)
  .map((item) => ({
    item,
    score:
      Number(item.data.topic === article.data.topic) * 4
      + Number(item.data.category === article.data.category) * 2
      + item.data.tags.filter((tag) => article.data.tags.includes(tag)).length,
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.item.data.publishedDate.valueOf() - a.item.data.publishedDate.valueOf())
  .map(({ item }) => item)
  .slice(0, 3);
---

<ArticleLayout {article} {headings} {related}>
  <Content />
</ArticleLayout>
