---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { categories, tools } from '../../data/site';
import { getCategoryGroups, getCategorySteps } from '../../data/categories';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.id }, props: { category } }));
}

type Category = (typeof categories)[number];
interface Props { category: Category }
const { category } = Astro.props;
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === category.id))
  .sort((a, b) => (a.data.articleOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.articleOrder ?? Number.MAX_SAFE_INTEGER)
    || Number(b.data.featured) - Number(a.data.featured)
    || b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const groups = [...getCategoryGroups(category)].sort((a, b) => a.order - b.order);
const steps = getCategorySteps(category);
const groupedArticles = groups.map((group) => ({
  group,
  articles: articles.filter((article) => article.data.group === group.id),
}));
const hasGroups = groups.length > 0;
const categoryTools = tools.filter((tool) => tool.category === category.id);

const url = new URL(`/chu-de/${category.id}/`, Astro.site ?? Astro.url.origin);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.name,
  description: category.metaDescription,
  url: url.href,
  isPartOf: { '@type': 'WebSite', name: 'Cẩm nang sinh viên', url: new URL('/', url).href },
};
---

<BaseLayout title={category.seoTitle} description={category.metaDescription} canonical={url.pathname} schema={schema} image={category.heroImage}>
  <section class={`category-hero hero-${category.accent}`}>
    <img
      class="category-hero-image"
      src={category.heroImage}
      alt=""
      width="1536"
      height="864"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="category-hero-shade" aria-hidden="true"></div>
    <div class="category-hero-content container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a><span>/</span><a href="/cam-nang/">Cẩm nang</a><span>/</span><span aria-current="page">{category.shortName}</span></nav>
      <p class="eyebrow">Chủ đề {category.number}</p>
      <h1>{category.name}</h1>
      <p class="lead">{category.description}</p>
      <p class="big-promise">{category.promise}</p>
    </div>
  </section>

  {(hasGroups || steps.length > 0) && (
    <section class="section-tight path-section">
      <div class="container">
        <p class="eyebrow">Nên đi theo thứ tự</p>
        {hasGroups
          ? (
            <nav class="path-grid" aria-label={`Các nhóm trong chủ đề ${category.name}`}>
              {groups.map((group) => (
                <a class="path-step path-link" href={`#${group.id}`}>
                  <span>{group.order}</span>
                  <span><strong>{group.shortTitle ?? group.title}</strong><small>{group.navigationDescription ?? group.description}</small></span>
                </a>
              ))}
            </nav>
          )
          : (
            <div class="path-grid">
              {steps.map((item, index) => (
                <div class="path-step">
                  <span>{index + 1}</span>
                  <span><strong>{item.label}</strong><small>{item.text}</small></span>
                </div>
              ))}
            </div>
          )}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Cẩm nang chọn lọc</p><h2>{articles.length} bài để bắt đầu</h2></div>
        <div class="article-section-actions">
          <a class="arrow-link" href="/cam-nang/">Tìm trong tất cả bài <Icon name="arrow" size={18} /></a>
          {articles.length > 0 && (
            <div class="view-switcher" role="group" aria-label="Kiểu hiển thị bài viết">
              <button class="view-button active" type="button" data-article-view="list" aria-pressed="true" aria-controls="category-articles">Danh sách</button>
              <button class="view-button" type="button" data-article-view="card" aria-pressed="false" aria-controls="category-articles">Dạng thẻ</button>
            </div>
          )}
        </div>
      </div>
      {articles.length > 0 || hasGroups ? (
        <div id="category-articles" class:list={['article-collection', 'view-list', { grouped: hasGroups, 'article-grid': !hasGroups }]}>
          {hasGroups
            ? groupedArticles.map(({ group, articles: groupArticles }) => (
                <section id={group.id} class="category-group" aria-labelledby={`${group.id}-title`}>
                  <header class="category-group-heading">
                    <span aria-hidden="true">{String(group.order).padStart(2, '0')}</span>
                    <div>
                      <h2 id={`${group.id}-title`}>{group.title}</h2>
                      <p>{group.description}</p>
                    </div>
                  </header>
                  {groupArticles.length > 0
                    ? <div class="article-grid group-article-grid">{groupArticles.map((article) => <ArticleCard article={article} />)}</div>
                    : <p class="group-empty">Nội dung cho nhóm này đang được chuẩn bị.</p>}
                </section>
              ))
            : articles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <div class="category-empty">
          <span aria-hidden="true">{category.number}</span>
          <div><h3>Nội dung đang được chuẩn bị</h3><p>Chủ đề này đã có cấu trúc riêng. Bài mẫu sẽ được thêm sau khi giao diện được duyệt.</p></div>
        </div>
      )}
    </div>
  </section>

  {categoryTools.length > 0 && (
    <section class="section section-muted">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Thực hành ngay</p><h2>Công cụ cho chủ đề này</h2></div></div>
        <div class="tool-buttons">
          {categoryTools.map((tool) => <a class="button button-dark" href={`/cong-cu/${tool.slug}/`}>{tool.name} <Icon name="arrow" size={18} /></a>)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const articleCollection = document.querySelector<HTMLElement>('#category-articles');
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-article-view]')];

  for (const button of viewButtons) {
    button.addEventListener('click', () => {
      const view = button.dataset.articleView === 'card' ? 'card' : 'list';
      articleCollection?.classList.toggle('view-list', view === 'list');
      articleCollection?.classList.toggle('view-card', view === 'card');

      for (const item of viewButtons) {
        const selected = item === button;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-pressed', String(selected));
      }
    });
  }
</script>

<style>
  .category-hero { --hero-accent: var(--mint); position: relative; display: grid; min-height: clamp(440px, 56vh, 620px); overflow: hidden; color: white; background: var(--ink); isolation: isolate; place-items: center; }
  .hero-mint { --hero-accent: var(--mint); }
  .hero-blue { --hero-accent: var(--blue); }
  .hero-yellow { --hero-accent: var(--yellow); }
  .hero-coral { --hero-accent: var(--coral); }
  .category-hero-image, .category-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .category-hero-image { z-index: -2; object-fit: cover; }
  .category-hero-shade { z-index: -1; background: linear-gradient(180deg, rgba(7, 17, 35, .5), rgba(7, 17, 35, .78)); }
  .category-hero-content { min-width: 0; padding-block: clamp(2.5rem, 7vw, 5rem); text-align: center; }
  .category-hero h1 { max-width: 980px; margin: 1rem auto 1.2rem; color: white; font-size: clamp(2.5rem, 6vw, 3.8rem); line-height: 1.04; text-shadow: 0 3px 24px rgba(0, 0, 0, .4); text-wrap: balance; }
  .category-hero .lead { max-width: 820px; margin: 0 auto; color: rgba(255, 255, 255, .9); font-size: clamp(1.05rem, 2vw, 1.22rem); text-wrap: balance; }
  .category-hero .eyebrow { margin-bottom: 0; color: white; text-shadow: 0 2px 15px rgba(0, 0, 0, .45); }
  .category-hero .breadcrumb { justify-content: center; margin-bottom: 1.5rem; color: rgba(255, 255, 255, .82); }
  .big-promise { display: inline-flex; max-width: 640px; margin: 1.5rem auto 0; padding: .75rem 1rem; color: white; background: rgba(7, 17, 35, .42); border: 1px solid rgba(255, 255, 255, .42); border-left: 4px solid var(--hero-accent); border-radius: 4px 12px 12px 4px; font-family: var(--font-display); font-size: .95rem; font-weight: 800; backdrop-filter: blur(8px); }
  .path-section { background: white; border-bottom: 1px solid var(--line); }
  .path-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .path-step { display: flex; gap: .8rem; padding: .9rem; color: inherit; border: 1px solid transparent; border-radius: 12px; text-decoration: none; }
  .path-link { cursor: pointer; transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
  .path-link:hover { border-color: var(--line-strong); box-shadow: 0 7px 18px rgba(16, 33, 63, .07); transform: translateY(-2px); }
  .path-link:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .path-step > span { display: grid; width: 34px; height: 34px; flex: 0 0 auto; color: white; background: var(--ink); border-radius: 50%; font-family: var(--font-display); font-size: .78rem; font-weight: 800; place-items: center; }
  .path-step > span:last-child { display: block; width: auto; min-width: 0; height: auto; flex: 1; color: inherit; background: transparent; border-radius: 0; font-family: inherit; font-size: inherit; font-weight: inherit; }
  .path-step strong { font-family: var(--font-display); }
  .path-step small { display: block; margin-top: .25rem; overflow-wrap: anywhere; color: var(--ink-soft); font-size: .82rem; line-height: 1.55; }
  .article-section-actions { display: flex; align-items: flex-end; flex-direction: column; gap: .8rem; }
  .view-switcher { display: inline-flex; padding: .25rem; background: #e8edf4; border: 1px solid var(--line-strong); border-radius: 999px; }
  .view-button { min-height: 38px; padding: .45rem .8rem; background: transparent; border: 0; border-radius: 999px; cursor: pointer; font-size: .78rem; font-weight: 800; }
  .view-button:hover { background: rgba(255, 255, 255, .65); }
  .view-button.active { color: white; background: var(--ink); }
  .article-collection.view-list { grid-template-columns: 1fr; gap: .7rem; }
  .article-collection.grouped { display: block; }
  .category-group { padding-block: clamp(2.25rem, 5vw, 4rem); scroll-margin-top: 100px; }
  .category-group + .category-group { border-top: 1px solid var(--line-strong); }
  .category-group-heading { display: grid; max-width: 820px; grid-template-columns: auto minmax(0, 1fr); gap: 1.1rem; margin-bottom: 1.5rem; }
  .category-group-heading > span { color: var(--mint-dark); font-family: var(--font-display); font-size: 1rem; font-weight: 850; letter-spacing: .1em; }
  .category-group-heading h2 { margin: 0 0 .45rem; font-size: clamp(1.55rem, 3vw, 2.2rem); }
  .category-group-heading p { margin: 0; color: var(--ink-soft); line-height: 1.65; }
  .group-article-grid { margin-top: 0; }
  .article-collection.view-list .group-article-grid { grid-template-columns: 1fr; gap: .7rem; }
  .group-empty { margin: 0; padding: 1rem 1.15rem; color: var(--ink-soft); background: white; border: 1px dashed var(--line-strong); border-radius: 13px; }
  .article-collection.view-list :global(.article-card) { position: relative; display: grid; min-height: 0; grid-template-areas: 'title meta' 'summary meta'; grid-template-columns: minmax(0, 1fr) auto; gap: .3rem 1.5rem; padding: 1rem 1.15rem; border-radius: 13px; }
  .article-collection.view-list :global(.article-card:hover) { box-shadow: 0 8px 22px rgba(16, 33, 63, .06); transform: translateY(-1px); }
  .article-collection.view-list :global(.article-meta) { grid-area: meta; align-self: center; justify-content: flex-end; white-space: nowrap; }
  .article-collection.view-list :global(.topic-label) { display: none; }
  .article-collection.view-list :global(.article-card h3) { min-width: 0; grid-area: title; margin: 0; font-size: 1.08rem; }
  .article-collection.view-list :global(.article-card h3 a)::after { position: absolute; inset: 0; content: ''; }
  .article-collection.view-list :global(.article-card > p) { min-width: 0; grid-area: summary; margin: 0; overflow: hidden; color: var(--ink-soft); font-size: .82rem; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
  .article-collection.view-list :global(.card-footer) { display: none; }
  .tool-buttons { display: flex; flex-wrap: wrap; gap: .75rem; }
  .category-empty { display: flex; align-items: center; gap: 1.25rem; padding: 1.5rem; background: white; border: 1px dashed var(--line-strong); border-radius: var(--radius); }
  .category-empty > span { display: grid; width: 54px; height: 54px; flex: 0 0 auto; color: white; background: var(--ink); border-radius: 16px 7px 16px 7px; font-family: var(--font-display); font-weight: 800; place-items: center; }
  .category-empty h3 { margin-bottom: .35rem; }
  .category-empty p { margin: 0; color: var(--ink-soft); }
  @media (max-width: 760px) {
    .path-grid { grid-template-columns: 1fr; }
    .category-hero { min-height: clamp(460px, 70vh, 620px); }
    .category-hero h1 { font-size: clamp(2.35rem, 11vw, 3.35rem); }
    .category-hero-image { object-position: center; }
    .big-promise { font-size: .88rem; }
    .article-section-actions { align-items: flex-start; margin-top: 1rem; }
    .category-group-heading { grid-template-columns: 1fr; gap: .45rem; }
    .article-collection.view-list :global(.article-card) { grid-template-areas: 'title' 'summary' 'meta'; grid-template-columns: 1fr; gap: .35rem; }
    .article-collection.view-list :global(.article-meta) { justify-content: flex-start; }
  }
</style>
