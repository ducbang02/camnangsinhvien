---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const turnstileSiteKey = '0x4AAAAAAE6GIuHV4XK2u-GP';
---

<BaseLayout
  title="Liên hệ"
  description="Gửi góp ý nội dung, báo lỗi hoặc đề nghị hợp tác với Cẩm nang sinh viên."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Liên hệ</p>
      <h1>Mỗi góp ý tốt đều giúp cẩm nang hữu ích hơn.</h1>
      <p class="lead">Bạn có thể góp ý bài viết, báo thông tin cần cập nhật hoặc trao đổi một đề nghị hợp tác phù hợp với sinh viên.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-reasons" aria-label="Các nội dung có thể liên hệ">
        <article>
          <Icon name="book" size={26} />
          <div><h2>Góp ý nội dung</h2><p>Đề xuất chủ đề, bổ sung một góc nhìn hoặc cho chúng mình biết bước nào trong bài còn khó hiểu.</p></div>
        </article>
        <article>
          <Icon name="search" size={26} />
          <div><h2>Báo lỗi và cập nhật</h2><p>Gửi đường dẫn bài viết cùng chi tiết cần sửa nếu bạn thấy dữ liệu cũ, liên kết hỏng hoặc nội dung chưa chính xác.</p></div>
        </article>
        <article>
          <Icon name="spark" size={26} />
          <div><h2>Hợp tác</h2><p>Chúng mình ưu tiên những đề nghị minh bạch, phù hợp với sinh viên và tôn trọng tiêu chuẩn nội dung của website.</p></div>
        </article>

        <aside class="privacy-card">
          <Icon name="shield" size={24} />
          <div>
            <h2>Dữ liệu được dùng để phản hồi bạn</h2>
            <p>Website không lưu biểu mẫu vào database. Nội dung được chuyển tới email quản trị qua Cloudflare Email Service.</p>
          </div>
        </aside>
      </div>

      <div class="contact-card">
        <p class="eyebrow">Gửi lời nhắn</p>
        <h2>Chúng mình đang lắng nghe.</h2>
        <p class="contact-intro">Điền đủ thông tin bên dưới. Các trường có dấu <span aria-hidden="true">*</span> là bắt buộc.</p>

        <form id="contact-form" novalidate>
          <div class="field">
            <label for="contact-name">Họ và tên <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" minlength="2" maxlength="80" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="contact-email">Email <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" required />
          </div>

          <div class="field">
            <label for="contact-type">Bạn muốn liên hệ về <span aria-hidden="true">*</span></label>
            <select id="contact-type" name="type" required>
              <option value="">Chọn một nội dung</option>
              <option value="gop-y-noi-dung">Góp ý nội dung</option>
              <option value="bao-loi-cap-nhat">Báo lỗi hoặc thông tin cần cập nhật</option>
              <option value="hop-tac">Đề nghị hợp tác</option>
              <option value="khac">Nội dung khác</option>
            </select>
          </div>

          <div class="field">
            <label for="contact-message">Lời nhắn <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" minlength="20" maxlength="5000" rows="8" placeholder="Hãy mô tả cụ thể để chúng mình có thể phản hồi đúng việc..." required></textarea>
            <small>Tối thiểu 20 và tối đa 5.000 ký tự.</small>
          </div>

          <div class="honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-action="contact"
            data-theme="light"
            data-language="vi"
          ></div>

          <button class="button button-primary submit-button" type="submit">Gửi liên hệ <Icon name="arrow" size={18} /></button>
          <p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>

<script>
  interface TurnstileWindow extends Window {
    turnstile?: { reset: (widget?: string | HTMLElement) => void };
  }

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  const submitButton = form?.querySelector<HTMLButtonElement>('[type="submit"]');
  const initialButtonMarkup = submitButton?.innerHTML ?? 'Gửi liên hệ';

  function showStatus(message: string, state: 'success' | 'error'): void {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    status?.removeAttribute('data-state');
    if (status) status.textContent = '';

    if (!form.checkValidity()) {
      form.reportValidity();
      showStatus('Vui lòng điền đủ các trường bắt buộc.', 'error');
      return;
    }

    const data = new FormData(form);
    const turnstileToken = String(data.get('cf-turnstile-response') ?? '');
    if (!turnstileToken) {
      showStatus('Vui lòng hoàn tất bước xác minh trước khi gửi.', 'error');
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Đang gửi…';
    }

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          type: data.get('type'),
          message: data.get('message'),
          website: data.get('website'),
          turnstileToken,
        }),
      });
      const result = await response.json() as { ok?: boolean; message?: string };

      if (!response.ok || result.ok !== true) {
        throw new Error(result.message || 'Chưa thể gửi liên hệ lúc này.');
      }

      form.reset();
      showStatus(result.message || 'Đã gửi liên hệ thành công.', 'success');
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Chưa thể gửi liên hệ lúc này.', 'error');
    } finally {
      const turnstile = (window as TurnstileWindow).turnstile;
      turnstile?.reset();
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.innerHTML = initialButtonMarkup;
      }
    }
  });
</script>

<style>
  .contact-layout { display: grid; grid-template-columns: minmax(0, .85fr) minmax(380px, 1.15fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .contact-reasons { display: grid; gap: 1rem; }
  .contact-reasons article,
  .privacy-card { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.3rem; background: white; border: 1px solid var(--line); border-radius: var(--radius); }
  .contact-reasons article > svg,
  .privacy-card > svg { color: var(--mint-dark); }
  .contact-reasons h2,
  .privacy-card h2 { margin: 0 0 .4rem; font-size: 1.08rem; }
  .contact-reasons p,
  .privacy-card p { margin: 0; color: var(--ink-soft); font-size: .9rem; }
  .privacy-card { margin-top: .5rem; background: #e8f8f3; border-color: #a4ddcf; }
  .contact-card { padding: clamp(1.5rem, 4vw, 2.25rem); background: white; border: 1px solid var(--line); border-radius: 24px 10px 24px 10px; box-shadow: 10px 10px 0 var(--mint); }
  .contact-card h2 { margin: .65rem 0 .75rem; font-size: clamp(1.5rem, 4vw, 2.15rem); }
  .contact-card .eyebrow { color: var(--mint-dark); }
  .contact-intro { margin-bottom: 1.5rem; color: var(--ink-soft); font-size: .9rem; }
  #contact-form { display: grid; gap: 1.15rem; }
  .field small { color: #6d798d; font-size: .75rem; }
  .field textarea[aria-invalid='true'] { border-color: var(--danger); }
  .submit-button { width: 100%; margin-top: .25rem; }
  .submit-button:disabled { cursor: wait; opacity: .65; }
  .contact-status { min-height: 1.6em; margin: 0; font-size: .86rem; font-weight: 700; }
  .contact-status[data-state='success'] { color: var(--success); }
  .contact-status[data-state='error'] { color: var(--danger); }
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 800px) { .contact-layout { grid-template-columns: 1fr; } }
  @media (max-width: 430px) { .contact-card { padding: 1.2rem; box-shadow: 6px 6px 0 var(--mint); } }
</style>
